CREATE OR REPLACE PROCEDURE p_result(v_nomdedept CHAR(50))
BEGIN
/*voici les variables utiles pour la procedure*/
  DECLARE v_nomcomple_emp VARCHAR(255) DEFAULT ''; -- pour le pointeur
  DECLARE v_listnom VARCHAR(255) DEFAULT ''; -- pour y ranger chaque nom complet trouver par le pointeur
  DECLARE v_fini BOOLEAN DEFAULT false ; -- pour le pointeur si fin de lecture.
  DECLARE c_pointeur CURSOR FOR SELECT CONCAT(E.prenom, ' ',E.nom)  
    FROM Employe E
    JOIN Departement D
    ON E.deptnr = D.numerodept
    WHERE D.nom=v_nomdedept; -- un poiteur de nom qui va les metre un à un dans la liste
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_fini = TRUE;
  /*si elle n'existe pas crée la table*/
  CREATE TABLE IF NOT EXISTS resultade(
    id INTEGER NOT NULL AUTO_INCREMENT PRIMARY KEY,
    Ladate DATE NOT NULL,
    NomDept VARCHAR(50) DEFAULT '',
    ListeEmployes VARCHAR (255) DEFAULT'');
  /*ouverture du curseur et de loop de fetch*/ --  ne me reprocher pas d'utilisé se style de commentaire c'est le meme qu'il y a dans vos questions...
  OPEN c_pointeur;
  read_loop: LOOP
    FETCH c_pointeur INTO v_nomcomple_emp ;
    SELECT CONCAT (v_listnom,',',v_nomcomple_emp) INTO v_listnom ;
    IF v_fini
    THEN
      LEAVE read_loop;
    END IF;  
  END loop read_loop;
  CLOSE c_pointeur;
  
  /*Inserer dans la table Reusltade*/
  INSERT INTO resultade(LaDate,NomDept,ListeEmployes)
  VALUES (NOW(),v_nomdedept,v_listnom);
  
END §çç§
