-- Faire une fonction qui trouver le nombre d'element dans une chaine de caractere qui porte des virgules
DELIMITER §çç§
CREATE OR REPLACE FUNCTION foreachelemnt(v_chain VARCHAR(200))
RETURNS INTEGER
BEGIN
  IF LENGTH(v_chain)>0
  THEN
    RETURN LENGTH(v_chain) - LENGTH(REPLACE(v_chain, ',', '')) +1;
  END IF;
  RETURN 0;
END §çç§
DELIMITER ;

