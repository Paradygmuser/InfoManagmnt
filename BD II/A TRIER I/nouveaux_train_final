CREATE DATABASE bibliotheque;
CREATE TABLE livre(
  id_livre INT AUTO_INCREMENT PRIMARY KEY UNIQUE,
  titre VARCHAR(255) NOT NULL,
  isbn INT NOT NULL,
  annee_publication DATETIME(year),
  id_auteur INT NOT NULL UNIQUE,
  nb_exemplaires INT DEFAULt 0,
  FOREIGN KEY (id_auteur) ON UPDATE CASCADE REFERENCES auteur
);

CREATE TABLE auteur(
  id_auteur INT AUTO_INCREMENT PRIMARY KEY UNIQUE,
  nom VARCHAR(255) NOT NULL,
  prenom VARCHAR(255) NOT NULL,
  nationalité VARCHAR(150) NOT NULL
);

CREATE TABLE emprunt (
  id_emprunt INT PRIMARY KEY UNIQUE,
  id_livre INT NOT NULL,
  id_membre INT NOT NULL,
  date_emprunt DATETIME DEFAULT '99-99-9999',
  date_retour_prevue DATETIME DEFAULT '99-99-9999',
  date_retour_reelle DATETIME DEFAULT '99-99-9999',
  FOREIGN KEY(id_livre) ON UPDATE CASCADE REFERENCES livre,
  FOREIGN KEY(id_membre) ON UPDATE CASCADE REFERENCES membre
);

CREATE TABLE membre(
  id_membre INT PRIMARY KEY UNIQUE, 
  nom VARCHAR(255) DEFAULT'', 
  prenom VARCHAR(255) DEFAULT '', 
  email VARCHAR(255) UNIQUE NOT NULL, 
  date_inscription DATETIME NOT NULL, 
  statut VARCHAR(50) DEFAULT 'ACTIF'
);

