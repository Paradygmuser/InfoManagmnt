 /*
# Créez une procédure qui crée ou met à jour une table « Results », 
détaillée ci-dessous, sur base d’une liste de noms de département fournis en paramètre. 
La table « Results » contient trois attributs :
#   a.	Id : Clé primaire assurant l’unicité de chaque enregistrement ;
#   b.  LaDate : Date d'insertion
#   c.	NomDept : Nom du département
#   d.	ListeEmployes : Chaine de caractères avec les prénoms et noms des employés le tout séparé par des virgules.
CALL p_listing ('Recherche,Administration');
SELECT * FROM results;
# */

DELIMITER §çç§
CREATE OR REPLACE PROCEDURE p_listing ( v_listdept VARCHAR(255))
BEGIN
  DECLARE v_listeUtile VARCHAR(255) DEFAULT '';
  DECLARE v_count INT DEFAULT 0; -- pour compter le nombre d'element dans la liste
  DECLARE v_listnom VARCHAR(255) DEFAULT ''; -- pour y concatener avec concat_ws
  DECLARE v_dept VARCHAR(255) DEFAULT '';
  DECLARE v_nom, v_prenom VARCHAR(255) DEFAuLT ''; -- deux varaible nom et prenom utile au curseur
  DECLARE v_fini BOOLEAN DEFAULT false;
  /*declaration du curseur qui permetra de lire chaque nom et prenom de l'employé en vue de la concatenation*/
  DECLARE c_pointeur CURSOR FOR SELECT prenom,E.nom FROM employe E JOIN departement D on deptnr=numerodept WHERE D.nom = v_dept;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_fini=true;  
  
  /*creation de la table si elle n'existe pas*/
  CREATE TABLE IF NOT EXISTS Results(
  Id INT NOT NULL AUTO_INCREMENT PRIMARY KEY UNIQUE,
  Ladate DATETIME NOT NULL,
  NomDept VARCHAR(255) DEFAULT'',
  ListeEmployees VARCHAR(255) DEFAULT''
  );
  /*Instructions*/
  SET v_listeUtile=v_listdept;
  SELECT LENGTH(v_listeUtile)-LENGTH(REPLACE(v_listeUtile,',',''))+1 INTO v_count; -- calclut moi le nombre d'eleent separer d'un virgule de la chaine sans les virgules 
  
  WHILE v_count>0 DO -- tant que se compteur est lus grand que zero DEBUT DE BOUCLE
  /*reinitialisation des attribut de boucle*/
  SET v_fini = FALSE ; -- pour réinitalisé a chaque boucle sinon le pointeur ne s'ouvre pas a la deuxieme boucle
  SET v_listnom = ''; -- pour effacer les nom du departements precedent
  /*instruction de boucle*/
  SELECT SUBSTRING_INDEX (v_listeUtile,',',1) INTO v_dept; -- prend le premier mot de la liste dans la variable v_dept 
  
  /*Fetcheur*/
    OPEN c_pointeur;
      read_loop: LOOP
        FETCH c_pointeur INTO v_prenom,v_nom;
        IF v_fini THEN LEAVE read_loop;
        END IF;
        IF (SELECT LENGTH(v_listnom))>1 THEN
        SELECT CONCAT_WS(',',v_listnom,CONCAT(v_prenom,' ',v_nom)) INTO v_listnom;-- concataine a la suite avec ',' la variable listnom et la concataination du fetch
        ELSE 
        SELECT CONCAT(v_prenom,' ',v_nom) INTO v_listnom;
        END IF;
      END LOOP; 
    CLOSE c_pointeur;
    /*insert dans le tableau les donnée : */
    INSERT INTO Results(Ladate,NomDept,ListeEmployees)
    VALUES(NOW(),v_dept,v_listnom);
  
  /*Ecrase le IN*/
  SELECT MID(v_listeUtile,LENGTH(v_dept)+2) INTO v_listeUtile;
  /*prend la chaine a partir de la fin de la longueur du premier mot dans la variable v_dept
  il prendra jusqu'a la fin de la chaine mais commencera avec la dernier lettre sanss +1 et avec une virgule sans le +2,
  Il ecrase le la variable par la nouvelle valeur
  */
  SET v_count= v_count-1; -- decrementation du count.   
  END WHILE;
END §çç§
DELIMITER ;

