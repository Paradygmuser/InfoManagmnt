CREATE OR REPLACE FUNCTION IndexerParDecenie(wxc INTEGER)
RETURNS INTEGER
BEGIN
DECLARE v_decenie INTEGER DEFAULT 0;
DECLARE v_age INTEGER DEFAULT 0;
DECLARE v_result INTEGER DEFAULT 0;

  SELECT TIMESTAMPDIFF(year,birth_date,NOW()) INTO v_age -- affice moi l'age
  FROM employees E
  JOIN salaries S ON S.emp_no=E.emp_no
  WHERE emp_no=wxc AND S.to_date>NOW(); -- AND to_date NOW car il doit encor travaillé dans l'entreprise.
    
  SELECT FLOOR((v_age-18)/10) INTO v_decenie;-- arrondi a l'unitée la plus petite  
  IF v_decenie>0 AND wxc IN(SELECT emp_no FROM dept_manager) -- si la decenie est au dessus de zero, pour eviter d'indexer un salaire a -100% ET que c'est bien un manager
  THEN    
    SELECT salary*v_decenie  
    INTO v_result FROM salaries
    WHERE emp_no =wxc;
  END IF;
  RETURN v_result;
END çç
