DELIMITER çç
CREATE OR REPLACE FUNCTION IndexerParDecenie(wxc INTEGER)
RETURNS INTEGER
BEGIN
DECLARE v_decenie INTEGER DEFAULT 0;
DECLARE v_age INTEGER DEFAULT 0;
DECLARE V_prime INTEGER DEFAULT 0;

  SELECT TIMESTAMPDIFF(year,birth_date,NOW()) INTO v_age 
  FROM employees E
  JOIN salaries S ON S.emp_no=E.emp_no
  WHERE E.emp_no=wxc AND S.to_date>NOW(); 
    
  SELECT FLOOR((v_age-18)/10) INTO v_decenie; 
  IF v_decenie>0  
  THEN    
    SELECT SUM(S.salary*v_decenie) 
    INTO V_prime FROM salaries S
    WHERE S.emp_no =wxc AND wxc IN(SELECT emp_no FROM dept_manager);
  ELSE 
    SELECT SUM(salary*1)  
    INTO V_prime FROM salaries
    WHERE emp_no =wxc AND wxc IN(SELECT emp_no FROM dept_manager);
  END IF;
  RETURN V_prime;
END çç
