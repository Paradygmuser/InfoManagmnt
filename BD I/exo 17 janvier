CREATE TABLE Voiture
(
num_plaque VARCHAR(10) NOT NULL,
marque VARCHAR(20) NOT NULL,
date_entre DATE NOT NULL ,
nss_conducteur INTEGER NOT NULL,
salaraire_min INTEGER DEFAULT 30000,

PRIMARY KEY (num_plaque),
FOREIGN KEY (nss_conducteur) REFERENCES Employe(nss)
);


